# Security headers for static assets served by the Workers asset server.
# These are NOT applied to responses generated by worker/index.ts — that code
# attaches its own headers (see worker/index.ts SECURITY_HEADERS).

/*
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
	X-Frame-Options: DENY
	Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
	Content-Security-Policy: default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'

# Fingerprinted build output can be cached hard.
/assets/*
	Cache-Control: public, max-age=31536000, immutable